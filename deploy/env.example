# 复制到 /srv/aml/.env（不进仓库）
DATABASE_URL=postgresql://aml:aml-local-only@127.0.0.1:5432/aml
AML_API_TOKEN=change-me
DASHSCOPE_API_KEY=
EMBED_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024
SEARCH_BUDGET_TOKENS=60000
SEARCH_TIMEOUT_S=10
# 第二枪（2026-09-30）新增的运行值；线上第二实例的覆盖文件是 /srv/aml/.env2（deploy/deploy-v2.sh 写）
EMBED_TIMEOUT_S=20
EMBED_CONNECT_TIMEOUT_S=5
EMBED_CONCURRENCY=16
RERANK_TIMEOUT_S=45
RERANK_ATTEMPT_TIMEOUT_S=20
RERANK_CONCURRENCY=16
THREAD_POOL_SIZE=16
LOOP_LAG_WARN_S=0.5
